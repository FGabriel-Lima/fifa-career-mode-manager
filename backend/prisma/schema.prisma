// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// 1. Define o "gerador" do Prisma Client (para o seu código Node.js)
generator client {
  provider = "prisma-client-js"
}

// 2. Define a fonte de dados (lê o .env que você acabou de configurar)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- 1. USUÁRIOS ----
model usuarios {
  id          Int         @id @default(autoincrement())
  email       String      @unique @db.VarChar(255)
  senha_hash  String      @db.VarChar(255)
  criado_em   DateTime    @default(now())
  carreiras   carreiras[]
}

// ---- 2. CARREIRA E TEMPORADAS ----
model carreiras {
  id            Int         @id @default(autoincrement())
  nome_carreira String      @db.VarChar(100)
  usuario_id    Int
  
  // Se deletar o usuário, apaga as carreiras
  usuario       usuarios    @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  temporadas    temporadas[]
  jogadores     jogadores[]
  observacao    observacao[]
}

model temporadas {
  id                      Int       @id @default(autoincrement())
  nome                    String    @db.VarChar(50)
  clube_nome              String    @db.VarChar(100)
  orcamento_transferencia Decimal?  @default(0)
  orcamento_salarios      Decimal?  @default(0)
  carreira_id             Int

  // Se deletar a carreira, apaga as temporadas
  carreira                carreiras @relation(fields: [carreira_id], references: [id], onDelete: Cascade)

  elenco                elenco_temporada[]
  transferencias        transferencias[]
  titulos_conquistados  titulos_conquistados[]
  ligas                 ligas_temporada[]
  premio_temporada      premios_temporada?
}

// ---- 3. JOGADORES E ELENCO ----
model jogadores {
  id                 Int      @id @default(autoincrement())
  nome_completo      String   @db.VarChar(100)
  posicao            String   @db.VarChar(10)
  nacionalidade      String?  @db.VarChar(50)
  carreira_id        Int
  total_jogos        Int      @default(0)
  total_gols         Int      @default(0)
  total_assistencias Int      @default(0)

  // Se deletar a carreira, apaga os jogadores
  carreira           carreiras @relation(fields: [carreira_id], references: [id], onDelete: Cascade)

  temporadas_elenco  elenco_temporada[]
  transferencias     transferencias[]
  candidaturas_premio candidatos_premio[]
}

model elenco_temporada {
  id               Int      @id @default(autoincrement())
  jogador_id       Int
  temporada_id     Int
  overall          Int
  idade            Int
  valor_mercado    Decimal? @default(0)
  jogos_disputados Int?     @default(0)
  gols             Int?     @default(0)
  assistencias     Int?     @default(0)

  // Se deletar o jogador ou a temporada, limpa a entrada do elenco
  jogador          jogadores  @relation(fields: [jogador_id], references: [id], onDelete: Cascade)
  temporada        temporadas @relation(fields: [temporada_id], references: [id], onDelete: Cascade)
}

// ---- 4. EVENTOS E ANOTAÇÕES ----
model transferencias {
  id                   Int        @id @default(autoincrement())
  temporada_id         Int
  jogador_id           Int? 
  tipo_transferencia   String     @db.VarChar(10)
  nome_jogador_externo String?    @db.VarChar(100)
  time_origem          String?    @db.VarChar(100)
  time_destino         String?    @db.VarChar(100)
  valor_transferencia  Decimal    @default(0)
  data_transferencia   DateTime?  @default(now())

  // Se deletar a temporada, apaga a transferência
  temporada            temporadas @relation(fields: [temporada_id], references: [id], onDelete: Cascade)
  // Se o jogador for deletado, podemos manter o registro histórico com Null ou apagar
  jogador              jogadores? @relation(fields: [jogador_id], references: [id], onDelete: Cascade)
}

model observacao {
  id           Int       @id @default(autoincrement())
  carreira_id  Int
  nome_jogador String    @db.VarChar(100)
  clube_atual  String?   @db.VarChar(100)
  idade_aprox  Int?
  posicao      String?   @db.VarChar(10)
  notas        String?   @db.Text

  carreira     carreiras @relation(fields: [carreira_id], references: [id], onDelete: Cascade)
}

// ---- 5. ALMANAQUE (Títulos e Ligas) ----
model titulos_conquistados {
  id             Int        @id @default(autoincrement())
  temporada_id   Int
  nome_titulo    String     @db.VarChar(100)
  clube_vencedor String     @db.VarChar(100)
  clube_vice      String?    @db.VarChar(100)

  temporada      temporadas @relation(fields: [temporada_id], references: [id], onDelete: Cascade)
}

model ligas_temporada {
  id            Int      @id @default(autoincrement())
  temporada_id  Int
  nome_liga     String   @db.VarChar(100)

  temporada     temporadas @relation(fields: [temporada_id], references: [id], onDelete: Cascade)
  classificacao classificacao_equipe[]
}

model classificacao_equipe {
  id                Int             @id @default(autoincrement())
  liga_temporada_id Int
  posicao           Int
  nome_time         String          @db.VarChar(100)
  pontos            Int
  vitorias          Int?            @default(0)
  empates           Int?            @default(0)
  derrotas          Int?            @default(0)
  gols_pro          Int?            @default(0)
  gols_contra       Int?            @default(0)

  // Se deletar a liga da temporada, apaga a classificação
  liga              ligas_temporada @relation(fields: [liga_temporada_id], references: [id], onDelete: Cascade)
}

// ---- 6. MÓDULO DE PRÊMIOS ----
model premios_temporada {
  id             Int        @id @default(autoincrement())
  temporada_id   Int        @unique 
  nome_premio    String     @default("Melhor do Mundo (CM)") @db.VarChar(100)
  vencedor_nome  String?    @db.VarChar(100)
  vencedor_clube String?    @db.VarChar(100)

  temporada      temporadas @relation(fields: [temporada_id], references: [id], onDelete: Cascade)
  candidatos     candidatos_premio[]
}

model candidatos_premio {
  id               Int               @id @default(autoincrement())
  premio_id        Int
  jogador_id       Int?              
  
  nome_jogador     String            
  clube            String
  gols_champions   Int               @default(0)
  assist_champions Int               @default(0)
  ganhou_liga      Boolean           @default(false)
  vice_liga        Boolean           @default(false)
  ganhou_champions Boolean           @default(false)
  vice_champions   Boolean           @default(false)

  premio           premios_temporada @relation(fields: [premio_id], references: [id])
  jogador          jogadores?        @relation(fields: [jogador_id], references: [id]) // <-- "?" aqui também
}